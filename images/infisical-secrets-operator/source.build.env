# infisical-secrets-operator — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# This image compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=infisical-secrets-operator BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves → README.md, ADR 0010.

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# Matches upstream's tag (v0.11.8); the "v" prefix is part of the version string upstream
# itself embeds via internal/util.Version (baked into the operator's outbound HTTP
# User-Agent header, upstream internal/util/version.go), so it is kept here too.
APP_VERSION=v0.11.8

# The commit github.com/Infisical/kubernetes-operator's infisical-k8-operator/v0.11.8 tag
# points at (peeled from the tag object).
SOURCE_COMMIT=fc5931fb329feeeeb17b84646772bfcabe1f7dc1

# An official golang image tag satisfying go.mod's `go 1.25.0` requirement and clearing
# the blocking stdlib CVEs (fixed on 1.25.13/1.26.6/1.27.0-rc.3 — per-branch
# alternatives, not one higher version). Used only in the builder stage; it does not
# survive into the final image. Do not pick it by hand — derive/confirm the value with:
#   python3 scripts/build/suggest-go-upgrades.py --reports <trivy-reports> --image infisical-secrets-operator
GO_BUILDER_TAG=1.26.7-trixie

# Final runtime base — this repository uses SUSE BCI only (docs/image-authoring/README.md rule 2).
# The binary is statically linked (CGO_ENABLED=0, same as upstream's own Dockerfile), so
# the lightest variant without a package manager, bci-micro, is sufficient.
RUNTIME_BASE=registry.suse.com/bci/bci-micro:15.7

# Vulnerable transitive modules, force-upgraded to their minimum fixed version (see
# README.md). `go get` settles the remaining compatible versions — individual go.sum
# versions are not listed here. Do not hand-pick; re-derive with:
#   python3 scripts/build/suggest-go-upgrades.py --reports <trivy-reports> --image infisical-secrets-operator --apply --dry-run
#
# x/net and x/text raised past the suggester's derivation on 2026-09-04 — the same
# x/crypto -> x/net -> x/text chain documented in images/argocd/source.build.env. A
# suggestion is only the minimum the CVE needs; chase "requires X, not Y" as far as it goes.
GO_MODULE_UPGRADES="golang.org/x/crypto@v0.55.0 golang.org/x/net@v0.57.0 golang.org/x/text@v0.41.0 google.golang.org/grpc@v1.83.1"

BUILD_ARGS="SOURCE_COMMIT APP_VERSION GO_BUILDER_TAG RUNTIME_BASE GO_MODULE_UPGRADES"
