# adc — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# The builder stage is upstream's own (node:lts-bookworm-slim); only the final stage becomes
# SUSE BCI — a source-build shape with no "base OS choice", so call it with BASE_OS=source:
#   IMAGE=adc BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves → the comment at the top of source.Dockerfile, and README.md.

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# The stock 0.29.0 is distinguished by the tag slug (TAG_SLUG=security), so the version
# string itself is left as-is.
APP_VERSION=0.29.0

# The actual commit the "v0.29.0" tag points at (a lightweight tag — no separate peeled commit).
# To check: git ls-remote --tags https://github.com/api7/adc.git v0.29.0
SOURCE_COMMIT=6594ee9f7cd9fd8786c0d11601c1ed05377646a1

BUILD_ARGS="SOURCE_COMMIT"
