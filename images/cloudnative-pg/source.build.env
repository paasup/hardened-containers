# CloudNativePG operator — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# This image compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=cloudnative-pg BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves / CVE evidence → README.md
# Decision → docs/decisions/0002-cloudnative-pg-operator-self-build.md

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# The stock 1.30.0 is distinguished by the tag slug (TAG_SLUG=security), so the version
# string itself is left as-is.
APP_VERSION=1.30.0

# A commit on the upstream maintenance branch — rationale in ADR 0002 and the git history.
# To update, a person picks the branch's current head again (not tracked automatically —
# a human-triggered update axis, like the PGDG version in cnpg-postgresql).
SOURCE_COMMIT=4463551204bc5cdb5af05b2c60a2d6b58ce9ff6a

# An official golang image tag satisfying go.mod's `go 1.26.5` (builder stage only; it does
# not survive into the final image). Derived by scripts/build/suggest-go-upgrades.py —
# rationale in ADR 0002 and the git history. Do not pick it by hand:
#   python3 scripts/build/suggest-go-upgrades.py --reports <trivy-reports> --image cloudnative-pg
GO_BUILDER_TAG=1.26.6-trixie

# Final runtime base — the images in this repository use SUSE BCI only (decisions/0001).
# The lightest variant, bci-micro, is used instead of bci-base (no package manager, but
# bash and coreutils are present).
RUNTIME_BASE=registry.suse.com/bci/bci-micro:15.7

BUILD_ARGS="SOURCE_COMMIT GO_BUILDER_TAG APP_VERSION RUNTIME_BASE"
