# CloudNativePG operator — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# This image compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=cloudnative-pg BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves / CVE evidence → README.md
# Decision → docs/decisions/0002-cloudnative-pg-operator-self-build.md

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# Injected into the binary via ldflags (buildVersion), so it must name the release that
# SOURCE_COMMIT is — the stock image is distinguished by the tag slug (TAG_SLUG=security).
APP_VERSION=1.30.1

# The commit the upstream release tag v${APP_VERSION} points at (a lightweight tag, so this is
# the commit itself) — move both values together. To update, a person resolves the next tag:
#   git ls-remote --tags https://github.com/cloudnative-pg/cloudnative-pg.git v<version>
# (not tracked automatically — a human-triggered update axis, like the PGDG version in
# cnpg-postgresql). Rationale in ADR 0002 and the git history.
SOURCE_COMMIT=2a35abb4628f209d149825ef3c38011e0701ff2f

# An official golang image tag satisfying go.mod's `go 1.26.6` (builder stage only; it does
# not survive into the final image). Derived by scripts/build/suggest-go-upgrades.py —
# rationale in ADR 0002 and the git history. Do not pick it by hand:
#   python3 scripts/build/suggest-go-upgrades.py --reports <trivy-reports> --image cloudnative-pg
# The suggester only weighs HIGH and above; one patch above its minimum here also clears an
# unrated stdlib CVE — rationale in README.md.
GO_BUILDER_TAG=1.26.11-trixie

# Final runtime base — the images in this repository use SUSE BCI only (decisions/0001).
# The lightest variant, bci-micro, is used instead of bci-base (no package manager, but
# bash and coreutils are present).
RUNTIME_BASE=registry.suse.com/bci/bci-micro:15.7

# Vulnerable transitive module(s), force-upgraded to their minimum fixed version. Empty when
# the release tag's own go.mod already carries every fix — remove an entry once the pinned
# release's go.mod meets it.
# The key is declared even while empty so that suggest-go-upgrades.py --apply can raise it
# on its own: --apply substitutes existing KEY=value lines and never adds a missing key, so
# an absent key means this image silently drops out of the automated Go CVE fix. Do not
# hand-pick a value here — derive with:
#   python3 scripts/build/suggest-go-upgrades.py --reports <trivy-reports> --image cloudnative-pg --apply --dry-run
GO_MODULE_UPGRADES="golang.org/x/net@v0.62.0"

BUILD_ARGS="SOURCE_COMMIT GO_BUILDER_TAG APP_VERSION RUNTIME_BASE GO_MODULE_UPGRADES"
