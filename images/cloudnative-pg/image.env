# Default build variant — used when no base_os input is given
# (images/<image>/<DEFAULT_BASE_OS>.build.env)
DEFAULT_BASE_OS=source

# Upstream support line — which release line this image is entitled to sit on.
# `manual` because endoflife.date has no entry for this project; SUPPORT_REF is what a
# person reads instead. See docs/image-authoring/support-policy.md.
SUPPORT_SOURCE=manual
SUPPORT_REF=https://cloudnative-pg.io/docs/devel/supported_releases
SUPPORT_NOTE="The operator publishes its own supported-releases page, which also declares which PostgreSQL majors it supports — check both when moving this pin, since the operator's PostgreSQL support set constrains the cnpg-postgresql image."
