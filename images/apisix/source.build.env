# apisix — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# This image compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=apisix BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves, and how it is composed → README.md.

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# The stock 3.18.0 is distinguished by the tag slug (TAG_SLUG=security), so the version
# string itself is left as-is.
APP_VERSION=3.18.0

# Where these values come from and how they are updated: see "Source and version management"
# in README.md.
#
# The module set below is not chosen here — it reproduces api7/apisix-build-tools at tag
# `apisix-runtime/${APISIX_RUNTIME_VER}`, and APISIX itself declares which runtime it needs
# in its own `.requirements` (APISIX_RUNTIME=1.3.16 at tag 3.18.0). Read both when moving
# APISIX_VERSION; a runtime bump is what moves these, not a decision of ours.
APISIX_VERSION=3.18.0
OPENRESTY_VERSION=1.29.2.4
OPENSSL_VERSION=3.4.1
ZLIB_VERSION=1.3.1
PCRE_VERSION=8.45
APISIX_NGINX_MODULE_VER=1.19.9
WASM_NGINX_MODULE_VER=0.7.0
LUA_VAR_NGINX_MODULE_VER=v0.5.3
LUA_RESTY_EVENTS_VER=0.2.0
NGX_MULTI_UPSTREAM_MODULE_VER=1.3.3
MOD_DUBBO_VER=1.0.2
# APISIX 3.18 makes the FFI HTTP client the default, which lives in this nginx module —
# without it the runtime is missing what the application now expects.
NGX_HTTP_FFI_CLIENT_VER=v0.1.3
APISIX_RUNTIME_VER=1.3.16

# This image replaces OpenResty's bundled lua-resty-limit-traffic (0.09) with the api7 fork.
# The two versions are separate values so the version is not written in two places (the
# directory being replaced, and the replacement itself).
OR_LIMIT_TRAFFIC_VER=0.09
LIMIT_TRAFFIC_VER=1.2.0

# --- tarball integrity pins ----------------------------------------------------
# This is the only image that fetches source tarballs (the others use a BuildKit git
# context, where the commit SHA guarantees integrity). Tarballs have no such guarantee, so
# their SHA256 is pinned as a committed value and the Dockerfile verifies it with
# `sha256sum -c` — a mismatch fails the build immediately.
#
# These values are the same kind of thing as SOURCE_COMMIT: "a record of what we verified"
# (design rule 4). Always update them together with the version. To derive one:
#   curl -fsSL -o f.tar.gz <URL> && sha256sum f.tar.gz
# Where possible, cross-check against a value published somewhere other than the download
# host (see OPENSSL below).
ZLIB_SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
PCRE_SHA256=4e6ce03e0336e8b4a3d6c2b70b1c5e18590a5673a98186da90d4f33c23defc09
# Downloaded from the github release, but the value was cross-checked against the official
# checksum published by openssl.org:
#   https://openssl.org/source/openssl-3.4.1.tar.gz.sha256
OPENSSL_SHA256=002a2d6b30b58bf4bea46c43bdd96365aaf8daa6c428782aa4feee06da197df3
OPENRESTY_SHA256=39bdac218249b7917464e6159acffef25a320ae89adaeb23514f078f473497bd
LIMIT_TRAFFIC_SHA256=aca960438de0476f738280a0e5b81030143b9ab9a393e393ef82b70e112e764d
# utils/linux-install-luarocks.sh from the apache/apisix repository (at tag $APISIX_VERSION).
# Tags can move, so the downloaded script is verified before it is executed.
LUAROCKS_INSTALLER_SHA256=b78477e534fd21b11aa1da5a4e9a27b8c1d64f155baa8abf4b957e92961c14fb

BUILD_ARGS="APISIX_VERSION OPENRESTY_VERSION OPENSSL_VERSION ZLIB_VERSION PCRE_VERSION APISIX_NGINX_MODULE_VER WASM_NGINX_MODULE_VER LUA_VAR_NGINX_MODULE_VER LUA_RESTY_EVENTS_VER NGX_MULTI_UPSTREAM_MODULE_VER MOD_DUBBO_VER NGX_HTTP_FFI_CLIENT_VER APISIX_RUNTIME_VER OR_LIMIT_TRAFFIC_VER LIMIT_TRAFFIC_VER ZLIB_SHA256 PCRE_SHA256 OPENSSL_SHA256 OPENRESTY_SHA256 LIMIT_TRAFFIC_SHA256 LUAROCKS_INSTALLER_SHA256"
