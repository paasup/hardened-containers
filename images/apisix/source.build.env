# apisix — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# This image compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=apisix BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves, and how it is composed → README.md.

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# The stock 3.20.0 is distinguished by the tag slug (TAG_SLUG=security), so the version
# string itself is left as-is.
APP_VERSION=3.20.0
# The tag must name the source actually built — repo-checks compares APP_VERSION with this pin.
APP_VERSION_FROM=APISIX_VERSION

# Where these values come from and how they are updated: see "Source and version management"
# in README.md.
#
# The module set below is not chosen here — it reproduces api7/apisix-build-tools at tag
# `apisix-runtime/${APISIX_RUNTIME_VER}`, and APISIX itself declares which runtime it needs
# in its own `.requirements` (APISIX_RUNTIME=1.4.2 at tag 3.20.0). Read both when moving
# APISIX_VERSION; a runtime bump is what moves these, not a decision of ours.
APISIX_VERSION=3.20.0
# The commit the apache/apisix 3.20.0 tag points at (a lightweight tag — `git ls-remote`
# shows no peeled ^{} entry). Fetched through BuildKit's git context, so the commit is what
# is enforced; repo-checks ("tag matches the pinned source") ties it to APP_VERSION.
SOURCE_COMMIT=bc1e687fdb82883f86d1bca9fa4fbd6bb433682b
OPENRESTY_VERSION=1.31.8.1
OPENSSL_VERSION=3.5.9
ZLIB_VERSION=1.3.1
PCRE_VERSION=8.45
#
# Each nginx module is a *_VER (the upstream tag, kept as the directory name and the record of
# which tag was resolved) plus a *_COMMIT (what is actually fetched — BuildKit's git context
# checks out exactly that commit, rule 7). Every tag below is lightweight, so the SHA is the
# commit itself. The two must be raised together:
#   git ls-remote --tags <repo>.git 'refs/tags/<tag>' 'refs/tags/<tag>^{}'   # ^{} wins if present
APISIX_NGINX_MODULE_VER=1.20.3
APISIX_NGINX_MODULE_COMMIT=fa0559cd8916427183e50db8e5e12a6acf671ac2
WASM_NGINX_MODULE_VER=0.7.0
WASM_NGINX_MODULE_COMMIT=0b4b31d6ecfdbc587e8ea455ed6e920a98aadff1
LUA_VAR_NGINX_MODULE_VER=v0.5.3
LUA_VAR_NGINX_MODULE_COMMIT=dc04c71e14e8a0407831f9019043d7e6da61b3c3
LUA_RESTY_EVENTS_VER=0.2.0
LUA_RESTY_EVENTS_COMMIT=8448a92cec36ac04ea522e78f6496ba03c9b1fd8
NGX_MULTI_UPSTREAM_MODULE_VER=1.4.1
NGX_MULTI_UPSTREAM_MODULE_COMMIT=1271391a52e947b576ecbfced05d8bedcd22d04f
MOD_DUBBO_VER=1.0.2
MOD_DUBBO_COMMIT=4aabf9448fe4a49ca71009af8e03645ee5dadd15
# Since APISIX 3.18 the FFI HTTP client is the default, and it lives in this nginx module —
# without it the runtime is missing what the application expects.
NGX_HTTP_FFI_CLIENT_VER=v0.1.3
NGX_HTTP_FFI_CLIENT_COMMIT=ea8374ddf416ee2553a8aff60189310ca1b6b0c0
APISIX_RUNTIME_VER=1.4.2

# wasm-nginx-module's install-wasmtime.sh downloads the wasmtime C API tarball with no
# checksum. The Dockerfile does that download itself instead and verifies it. The version is
# the one the script hardcodes at WASM_NGINX_MODULE_COMMIT (`VER=v0.38.1`) — the build fails
# if the two diverge, so a module bump cannot silently leave this behind. Upstream publishes
# no checksum for this release; the x86_64 value was cross-checked by matching the tarball's
# lib/libwasmtime.so against the one in apache/apisix:3.20.0-debian (identical sha256).
WASMTIME_VERSION=v0.38.1
WASMTIME_C_API_SHA256_X86_64=686efb2a47eae17e11897c8e18116b38c1515bc2a74464d4d222c6265d1cff30
WASMTIME_C_API_SHA256_AARCH64=417a53e82b648757e2c3d370c652c8acbe90a8f1e481bfac9d9cacd44b2df4ed

# This image replaces OpenResty's bundled lua-resty-limit-traffic (0.09) with the api7 fork.
# The two versions are separate values so the version is not written in two places (the
# directory being replaced, and the replacement itself).
OR_LIMIT_TRAFFIC_VER=0.09
LIMIT_TRAFFIC_VER=1.2.0

# --- tarball integrity pins ----------------------------------------------------
# This is the only image that fetches source tarballs (its git sources, like every other
# image's, use a BuildKit git context, where the commit SHA guarantees integrity). Tarballs
# have no such guarantee, so
# their SHA256 is pinned as a committed value and the Dockerfile verifies it with
# `sha256sum -c` — a mismatch fails the build immediately.
#
# These values are the same kind of thing as SOURCE_COMMIT: "a record of what we verified"
# (design rule 4). Always update them together with the version. To derive one:
#   curl -fsSL -o f.tar.gz <URL> && sha256sum f.tar.gz
# Where possible, cross-check against a value published somewhere other than the download
# host (see OPENSSL below).
ZLIB_SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
PCRE_SHA256=4e6ce03e0336e8b4a3d6c2b70b1c5e18590a5673a98186da90d4f33c23defc09
# Downloaded from the github release, but the value was cross-checked against the official
# checksum published by openssl.org:
#   https://openssl.org/source/openssl-3.5.9.tar.gz.sha256
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
# Cross-checked by verifying the release's .asc signature against the PGP key openresty.org
# publishes for its releases (A0E98066, Yichun Zhang).
OPENRESTY_SHA256=b569c63b420f80a4ac8466f2deffe73ed93ab760026532e039c3658409a997f4
LIMIT_TRAFFIC_SHA256=aca960438de0476f738280a0e5b81030143b9ab9a393e393ef82b70e112e764d
# utils/linux-install-luarocks.sh from the apache/apisix repository (at tag $APISIX_VERSION).
# Tags can move, so the downloaded script is verified before it is executed.
LUAROCKS_INSTALLER_SHA256=c58a3ff32e2b8cad7e1004bb10a30cfc5b993b39f5e33e335ee1bbc3cafec765

BUILD_ARGS="APISIX_VERSION SOURCE_COMMIT OPENRESTY_VERSION OPENSSL_VERSION ZLIB_VERSION PCRE_VERSION APISIX_NGINX_MODULE_VER WASM_NGINX_MODULE_VER LUA_VAR_NGINX_MODULE_VER LUA_RESTY_EVENTS_VER NGX_MULTI_UPSTREAM_MODULE_VER MOD_DUBBO_VER NGX_HTTP_FFI_CLIENT_VER APISIX_RUNTIME_VER APISIX_NGINX_MODULE_COMMIT WASM_NGINX_MODULE_COMMIT LUA_VAR_NGINX_MODULE_COMMIT LUA_RESTY_EVENTS_COMMIT NGX_MULTI_UPSTREAM_MODULE_COMMIT MOD_DUBBO_COMMIT NGX_HTTP_FFI_CLIENT_COMMIT WASMTIME_VERSION WASMTIME_C_API_SHA256_X86_64 WASMTIME_C_API_SHA256_AARCH64 OR_LIMIT_TRAFFIC_VER LIMIT_TRAFFIC_VER ZLIB_SHA256 PCRE_SHA256 OPENSSL_SHA256 OPENRESTY_SHA256 LIMIT_TRAFFIC_SHA256 LUAROCKS_INSTALLER_SHA256"
