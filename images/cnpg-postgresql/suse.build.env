# CNPG PostgreSQL — SUSE BCI / zypper self-build (the DEFAULT_BASE_OS in image.env)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
#
# Measurability — trivy covers SLES 15.7 properly.
#   The coverage self-check (CoverageProbe) re-confirms this on every scan —
#   see docs/image-authoring/scanner-caveats.md

DOCKERFILE=suse.Dockerfile
TARGET=patched
TAG_SLUG=bci15.7

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# It equals the major.minor extracted from PG_VERSION below (the exact EVR of the PGDG
# package) — but the script does not parse PG_VERSION to derive it. The image must declare
# it explicitly.
APP_VERSION=18.4

BASE=registry.suse.com/bci/bci-base:15.7
PG_MAJOR=18
# The exact EVR in the PGDG zypp repository. The format differs from the apt side.
PG_VERSION=18.4-4200001PGDG.sles15.7
SLE_REPO=sles-15.7-x86_64
PGDG_KEY=PGDG-RPM-GPG-KEY-SLES15

# pg-failover-slots is excluded — there is no package for it in the PGDG zypp repository
# (a difference from the apt variant).
EXTENSIONS="pgaudit_18 pgvector_18"

BUILD_ARGS="BASE PG_MAJOR PG_VERSION SLE_REPO PGDG_KEY EXTENSIONS"
