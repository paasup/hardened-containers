# CNPG PostgreSQL — SUSE BCI / zypper self-build (the DEFAULT_BASE_OS in image.env)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
#
# Measurability — trivy covers SLES 15.7 properly.
#   The coverage self-check (CoverageProbe) re-confirms this on every scan —
#   see docs/image-authoring/scanner-caveats.md

DOCKERFILE=suse.Dockerfile
TARGET=patched
TAG_SLUG=bci15.7

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# It equals the major.minor extracted from PG_VERSION below (the exact EVR of the PGDG
# package) — but the script does not parse PG_VERSION to derive it. The image must declare
# it explicitly. verify.sh fails if the server in the image is not this version.
APP_VERSION=18.7
# repo-checks: APP_VERSION must equal the value that really selects the app.
APP_VERSION_FROM=PG_VERSION

BASE=registry.suse.com/bci/bci-base:15.7
PG_MAJOR=18
# The exact EVR in the PGDG zypp repository. The format differs from the apt side.
# Every postgresql${PG_MAJOR} package is installed at this EVR and then zypper-locked, so the
# `patched` stage's `zypper update` cannot move the server past it. Until 2026-11 it did:
# images tagged 18.4 shipped 18.7. To raise it, list the EVRs PGDG publishes with
#   zypper se -s -x postgresql18-server     (inside bci-base with the pgdg repo added)
# and raise APP_VERSION with it.
PG_VERSION=18.7-4200001PGDG.sles15.7
SLE_REPO=sles-15.7-x86_64
PGDG_KEY=PGDG-RPM-GPG-KEY-SLES15

# pg-failover-slots is excluded — there is no package for it in the PGDG zypp repository
# (a difference from the apt variant).
EXTENSIONS="pgaudit_18 pgvector_18"

# pg_textsearch (Timescale) — built from source in the pg-textsearch-build stage. Bump by hand;
# see README.md. The SHA256 is of the GitHub tag archive.
PG_TEXTSEARCH_VERSION=1.4.0
PG_TEXTSEARCH_SHA256=cab02b4e8af11f98b428d17cca9c5235ab55e12d79c20fa8fbb950708c4a1e92

BUILD_ARGS="BASE PG_MAJOR PG_VERSION SLE_REPO PGDG_KEY EXTENSIONS PG_TEXTSEARCH_VERSION PG_TEXTSEARCH_SHA256"
