# Default build variant — used when no base_os input is given
# (images/<image>/<DEFAULT_BASE_OS>.build.env)
DEFAULT_BASE_OS=source

# Upstream support line — which release line this image is entitled to sit on.
# Checked by scripts/build/check-support-line.py; see docs/image-authoring/support-policy.md.
SUPPORT_SOURCE=endoflife.date
SUPPORT_PRODUCT=kyverno
SUPPORT_LINE=1.19
SUPPORT_NOTE="Kyverno follows Kubernetes' support policy — the 3 most recent minor lines get security/bug fixes. 1.19 is newest as of this pin; endoflife.date's dataset may lag a few days behind a fresh minor release. Same upstream project and line as images/kyverno/ — this is the CLI built from the same source tree."
