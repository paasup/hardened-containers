# argocd — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# It compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=argocd BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Background: README.md. ADR: docs/decisions/0007-argocd-self-build.md.
# Which values change when handling a new blocking CVE: see "Handling the next CVE" in README.md.

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# The stock v3.5.4 is distinguished by the tag slug (TAG_SLUG=security), so the version
# string is left as-is.
APP_VERSION=3.5.4

# The commit the v3.5.4 tag points at — a lightweight tag, so it references the commit
# directly with no tag object.
SOURCE_COMMIT=d6d5b248ce00e1a2c512068002a93d3319767087

# The minimum Go version that resolves the blocking stdlib CVEs. Derived by
# suggest-go-upgrades.py. Used only in the builder stage; it does not survive into the
# final image.
GO_BUILDER_TAG=1.26.11-trixie

# For the UI build. Kept aligned with upstream's Dockerfile node pin — the UI bundle raises
# no scan findings, so there is no reason to move it, and staying consistent with the
# lockfile is safer.
NODE_BUILDER_TAG=24.14.1

# Final runtime base — the images in this repository use SUSE BCI only
# (docs/image-authoring/README.md rule 2). argocd needs git, gpg, and ssh at runtime, so it
# uses bci-base, which has a package manager.
#
# 16.0 — required for coreutils 9.3+ (the chart's init container uses `cp --update=none`).
# Details: README.md.
RUNTIME_BASE=registry.suse.com/bci/bci-base:16.0

# Bundled Go tools — upstream downloads release binaries via hack/install.sh, but the Go
# version in those binaries is old and was the main source of CVEs. They are rebuilt from
# source here. Which version each one sits on, and why: README.md.
#
# *_VERSION is the version string baked in via ldflags and checked by verify.sh;
# *_COMMIT is what is actually fetched — the commit the release tag points at (for an
# annotated tag, the peeled ^{} commit from `git ls-remote`), so BuildKit's git context
# verifies it (rule 7). The two must be raised together.
HELM_VERSION=4.3.2
HELM_COMMIT=8346aaa55e7161f7c547212d0a87f01367976727
KUSTOMIZE_VERSION=5.8.1
KUSTOMIZE_COMMIT=9790a1c3efd2fd35f1b768d495112834176581c1
GIT_LFS_VERSION=3.8.1
GIT_LFS_COMMIT=a662a6dbfedf706cfa9fc7a5b7bcc7ba2e2c8a65

# Built from source because SLE_BCI has no package for them.
# tini is upstream's ENTRYPOINT; connect-proxy is for SSH-over-proxy. Same *_COMMIT rule —
# here *_VERSION is not a build arg: TINI_VERSION is checked by verify.sh, and
# SSH_CONNECT_VERSION only records which tag SSH_CONNECT_COMMIT was resolved from.
TINI_VERSION=0.19.0
TINI_COMMIT=de40ad007797e0dcd8b7126f27bb87401d224240
SSH_CONNECT_VERSION=1.106
SSH_CONNECT_COMMIT=a7443d32e6bf6f00698384b0519adc16fa7656fa

# Go modules to force-upgrade — **applied across all four projects**: argocd, helm,
# kustomize, and git-lfs. go-mod-upgrade.sh applies only those present in each project's
# dependency graph, so one list can be reused as-is.
#
# Derive the values with suggest-go-upgrades.py. Note that a suggestion is the **minimum**
# the CVEs require — inter-module constraints may force it higher. If the build fails with
# "requires <module>@vX, not @vY", raise it to that version — chasing that message can take
# more than one hop. It did on 2026-09-04: the CVE-driven raise of x/crypto to v0.55.0
# (CVE-2026-56854) forced x/net to v0.57.0, and once x/net moved, x/crypto@v0.55.0 also
# required x/text@v0.41.0 while the newly raised x/net@v0.57.0 required x/text@v0.40.0 —
# x/text had to go to the higher of the two, v0.41.0, to satisfy both.
GO_MODULE_UPGRADES="golang.org/x/crypto@v0.59.0 golang.org/x/net@v0.62.0 golang.org/x/text@v0.44.0 google.golang.org/grpc@v1.83.2 github.com/go-git/go-git/v5@v5.19.2 oras.land/oras-go/v2@v2.6.2 github.com/go-jose/go-jose/v4@v4.1.6 github.com/klauspost/compress@v1.18.7 github.com/slack-go/slack@v0.23.1 go.opentelemetry.io/otel/exporters/otlp/otlptrace@v1.45.0 go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc@v1.45.0 go.opentelemetry.io/otel/sdk@v1.47.0 go.opentelemetry.io/otel/trace@v1.47.0"

# What c-builder needs to compile tini (cmake) and connect (gcc).
BUILDER_PACKAGES="gcc make cmake git-core tar gzip"

# Runtime packages for the final image — the SLE equivalents of upstream's apt list
# (see the mapping table in README.md).
RUNTIME_PACKAGES="git-core ca-certificates gpg2 timezone openssh-clients"

BUILD_ARGS="SOURCE_COMMIT APP_VERSION GO_BUILDER_TAG NODE_BUILDER_TAG RUNTIME_BASE HELM_VERSION HELM_COMMIT KUSTOMIZE_VERSION KUSTOMIZE_COMMIT GIT_LFS_VERSION GIT_LFS_COMMIT TINI_COMMIT SSH_CONNECT_COMMIT GO_MODULE_UPGRADES BUILDER_PACKAGES RUNTIME_PACKAGES"
