# argocd — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# It compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=argocd BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Background: README.md. ADR: docs/decisions/0007-argocd-self-build.md.
# Which values change when handling a new blocking CVE: see "Handling the next CVE" in README.md.

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# The stock v3.5.1 is distinguished by the tag slug (TAG_SLUG=security), so the version
# string is left as-is.
APP_VERSION=3.5.1

# The commit the v3.5.1 tag points at — a lightweight tag, so it references the commit
# directly with no tag object.
SOURCE_COMMIT=109ca7ca71139e514114499d294a492e7910a965

# The minimum Go version that resolves the blocking stdlib CVEs. Derived by
# suggest-go-upgrades.py. Used only in the builder stage; it does not survive into the
# final image.
GO_BUILDER_TAG=1.26.6-trixie

# For the UI build. Kept aligned with upstream's Dockerfile node pin — the UI bundle raises
# no scan findings, so there is no reason to move it, and staying consistent with the
# lockfile is safer.
NODE_BUILDER_TAG=24.14.1

# Final runtime base — the images in this repository use SUSE BCI only
# (docs/image-authoring/README.md rule 2). argocd needs git, gpg, and ssh at runtime, so it
# uses bci-base, which has a package manager.
#
# 16.0 — required for coreutils 9.3+ (the chart's init container uses `cp --update=none`).
# Details: README.md.
RUNTIME_BASE=registry.suse.com/bci/bci-base:16.0

# Bundled Go tools — upstream downloads release binaries via hack/install.sh, but the Go
# version in those binaries is old (git-lfs 1.25.3, kustomize 1.24.0) and was the main
# source of CVEs. They are rebuilt from source here. Only helm uses the latest instead of
# upstream's pin (4.2.1) — the other two pins are already current.
HELM_VERSION=4.2.4
KUSTOMIZE_VERSION=5.8.1
GIT_LFS_VERSION=3.7.1

# Built from source because SLE_BCI has no package for them.
# tini is upstream's ENTRYPOINT; connect-proxy is for SSH-over-proxy.
TINI_VERSION=0.19.0
SSH_CONNECT_VERSION=1.106

# Go modules to force-upgrade — **applied across all four projects**: argocd, helm,
# kustomize, and git-lfs. go-mod-upgrade.sh applies only those present in each project's
# dependency graph, so one list can be reused as-is.
#
# Derive the values with suggest-go-upgrades.py. Note that a suggestion is the **minimum**
# the CVEs require — inter-module constraints may force it higher. If the build fails with
# "requires <module>@vX, not @vY", raise it to that version (this happened with x/crypto).
GO_MODULE_UPGRADES="golang.org/x/crypto@v0.53.0 golang.org/x/net@v0.56.0 golang.org/x/text@v0.39.0 google.golang.org/grpc@v1.82.1 github.com/go-git/go-git/v5@v5.19.2 oras.land/oras-go/v2@v2.6.2"

# What c-builder needs to compile tini (cmake) and connect (gcc).
BUILDER_PACKAGES="gcc make cmake git-core tar gzip"

# Runtime packages for the final image — the SLE equivalents of upstream's apt list
# (see the mapping table in README.md).
RUNTIME_PACKAGES="git-core ca-certificates gpg2 timezone openssh-clients"

BUILD_ARGS="SOURCE_COMMIT APP_VERSION GO_BUILDER_TAG NODE_BUILDER_TAG RUNTIME_BASE HELM_VERSION KUSTOMIZE_VERSION GIT_LFS_VERSION TINI_VERSION SSH_CONNECT_VERSION GO_MODULE_UPGRADES BUILDER_PACKAGES RUNTIME_PACKAGES"
