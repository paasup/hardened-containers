# kyvernopre — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# This image compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=kyvernopre BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves → images/kyverno/README.md, ADR 0009.

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# Matches upstream's tag (v1.19.0); the "v" prefix is part of the version string upstream
# itself embeds via pkg/version.BuildVersion, so it is kept here too.
APP_VERSION=v1.19.0

# The commit github.com/kyverno/kyverno's v1.19.0 tag points at (peeled from the tag
# object) — same commit as every other kyverno image, all seven binaries come from one
# monorepo tag. See images/kyverno/README.md.
SOURCE_COMMIT=ee97ce09538b09b6f1b03853cc41a62654d6a58f

# An official golang image tag satisfying go.mod's `go 1.26.5` requirement. Used only in
# the builder stage; it does not survive into the final image. Do not pick it by hand —
# derive the value with:
#   python3 scripts/build/suggest-go-upgrades.py --reports <trivy-reports> --image kyvernopre
GO_BUILDER_TAG=1.26.7-trixie

# Final runtime base — this repository uses SUSE BCI only (docs/image-authoring/README.md rule 2).
# The binary is statically linked (CGO_ENABLED=0), so the lightest variant without a package
# manager, bci-micro, is sufficient.
RUNTIME_BASE=registry.suse.com/bci/bci-micro:15.7

# Vulnerable transitive module(s), force-upgraded to their minimum fixed version. Same
# go.mod as images/kyverno/ (single-module repository), and golang.org/x/mod is
# confirmed present in this binary's own SBOM (CVE-2026-56864, CVE-2026-56865) — verified
# by running the gate for this image specifically, not assumed from the kyverno result.
# Do not hand-pick this value — derive with:
#   python3 scripts/build/suggest-go-upgrades.py --reports <trivy-reports> --image kyvernopre --apply --dry-run
GO_MODULE_UPGRADES="golang.org/x/mod@v0.40.0"

BUILD_ARGS="SOURCE_COMMIT APP_VERSION GO_BUILDER_TAG RUNTIME_BASE GO_MODULE_UPGRADES"
