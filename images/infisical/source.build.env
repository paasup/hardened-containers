# infisical — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# This image compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=infisical BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves → README.md, ADR 0011.

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# Matches upstream's tag.
APP_VERSION=v0.164.1

# The commit github.com/Infisical/infisical's v0.164.1 tag points at (peeled from the tag object).
SOURCE_COMMIT=b9e1afabb836e825cf1778fba0c52175aed45b16

# Frontend builder — official Node image, matching upstream's own pin (Dockerfile.standalone-infisical).
# No native addons in the frontend build output (static Vite assets only), so no ABI concern —
# stays on the official Debian-based image per the normal default (docs/image-authoring/README.md rule 2's
# builder exemption).
NODE_BUILDER_TAG=22.22.0-trixie-slim

# Backend builder — deliberately NOT the official node image (see source.Dockerfile's header comment).
# The backend's production dependencies include native Node addons (argon2, bcrypt, odbc) compiled by
# npm ci — compiling them on Debian and running them on SUSE BCI risks a glibc ABI mismatch at load time.
# Same principle as the C/Lua rule in docs/image-authoring/builder-languages.md ("keep the builder stage
# and the final stage on the same base and link dynamically") — so the backend builder uses bci-base too.
RUNTIME_BASE=registry.suse.com/bci/bci-base:15.7
NODEJS_PKG=nodejs22
NODEJS_DEVEL_PKG=nodejs22-devel
NPM_PKG=npm22

# Vulnerable Node dependencies, force-upgraded to their minimum fixed version. Do not
# hand-pick; each entry below is the minimum version on the *same major line already in
# use* that clears the CVE (picking the highest version across every major listed in a
# comma-separated FixedVersion would force gratuitous breaking major bumps — see
# README.md "Version management"). Two exceptions forced onto a newer major because no
# same-major fix exists (ip-address 9.x -> 10.x, sigstore 2.x -> 4.x) — confirmed by
# build + verify.sh passing.
#
# Split in two because npm's `overrides` mechanism (npm's equivalent of Go's
# GO_MODULE_UPGRADES) cannot target a package that is also a direct dependency
# (`npm error EOVERRIDE`) — source.Dockerfile applies NPM_DIRECT_UPGRADES to
# `dependencies` itself and NPM_OVERRIDES via `overrides`, both through `npm pkg set`.
# oci-common@2.108.0 (direct, Infisical's OCI Vault integration) pins uuid@3.3.3 and uses
# uuid's legacy `uuid/v1` subpath API, which uuid 9+ removed from its package.json
# `exports` map entirely — forcing uuid to 11.1.1 without also bumping oci-common crashes
# the server at boot (ERR_PACKAGE_PATH_NOT_EXPORTED, caught by verify.sh). oci-common's
# own latest release (2.140.0) already migrated to modern uuid@11.1.1 usage, so bumping it
# resolves both the legacy-API crash and the nested uuid CVE at once.
NPM_DIRECT_UPGRADES="@fastify/static@10.1.1 axios@1.18.0 dd-trace@5.100.0 mysql2@3.22.0 nanoid@3.3.18 nodemailer@9.0.1 oci-common@2.140.0 scim-patch@0.9.1 uuid@11.1.1"
NPM_OVERRIDES="@grpc/grpc-js@1.14.4 adm-zip@0.6.0 brace-expansion@2.1.4 cross-spawn@7.0.5 diff@5.2.2 fast-uri@3.1.6 fast-xml-builder@1.1.7 find-my-way@9.7.0 form-data@4.0.6 glob@10.5.0 ip-address@10.3.1 js-yaml@4.3.1 minimatch@9.0.7 protobufjs@7.6.5 shell-quote@1.9.0 sigstore@4.1.1 tar@7.5.21 undici@7.29.0 websocket-driver@0.7.5"

BUILD_ARGS="SOURCE_COMMIT APP_VERSION NODE_BUILDER_TAG RUNTIME_BASE NODEJS_PKG NODEJS_DEVEL_PKG NPM_PKG NPM_DIRECT_UPGRADES NPM_OVERRIDES"
