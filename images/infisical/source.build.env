# infisical — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# This image compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=infisical BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves → README.md, ADR 0011.

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# Matches upstream's tag.
APP_VERSION=v0.167.11

# The commit github.com/Infisical/infisical's v0.167.11 tag points at (a lightweight tag — the ref is the commit).
SOURCE_COMMIT=37b7556d87f37adadc925593e4fe3d278cc71594

# Frontend builder — official Node image, matching upstream's own pin (Dockerfile.standalone-infisical).
# No native addons in the frontend build output (static Vite assets only), so no ABI concern —
# stays on the official Debian-based image per the normal default (docs/image-authoring/README.md rule 2's
# builder exemption).
NODE_BUILDER_TAG=26.12.1-trixie-slim

# Backend builder — deliberately NOT the official node image (see source.Dockerfile's header comment).
# The backend's production dependencies include native Node addons (argon2, bcrypt, odbc, pkcs11js) compiled by
# npm install — compiling them on Debian and running them on SUSE BCI risks a glibc ABI mismatch at load time.
# Same principle as the C/Lua rule in docs/image-authoring/builder-languages.md ("keep the builder stage
# and the final stage on the same base and link dynamically") — so the backend builder uses bci-base too.
RUNTIME_BASE=registry.suse.com/bci/bci-base:15.7
# nodejs24, not upstream's Node 26 — SLE_BCI 15.7 and 16.0 ship no nodejs26 (README.md "Runtime Node").
NODEJS_PKG=nodejs24
NODEJS_DEVEL_PKG=nodejs24-devel
NPM_PKG=npm24
# C++ compiler for the native addons — Node 24's headers need C++20, which SLE 15's default
# gcc-c++ (GCC 7) lacks. The runtime libstdc++6 (16.x on 15.7) is newer, so the ABI resolves.
BUILDER_GCC_VERSION=14

# Vulnerable Node dependencies, force-upgraded to the minimum fixed version on the major line
# already in use (trivy FixedVersion — not hand-picked). Re-measured from an empty list on every
# APP_VERSION bump: NPM_OVERRIDES entries are exact versions, so one that upstream's lockfile has
# since passed would pull that package back down. All three below are direct dependencies of
# backend/package.json, so none can go through NPM_OVERRIDES (npm EOVERRIDE); fast-xml-parser
# also already carries upstream's own string override, which the Dockerfile replaces.
#   node-forge 1.4.2 -> 1.4.3                          CVE-2026-125332..125335
#   fast-xml-parser 5.7.2 -> 5.12.0                    CVE-2026-126066
#   @opentelemetry/instrumentation-http 0.220 -> 0.222 CVE-2026-128080
# Deferred: glob 10 / minimatch 9 (fixed only in glob 14 / minimatch 11 — upstream pins glob ^10.5.0
# itself). Why each is or is not here: README.md "Version management".
NPM_DIRECT_UPGRADES="@opentelemetry/instrumentation-http@0.222.0 fast-xml-parser@5.12.0 node-forge@1.4.3"
NPM_OVERRIDES=""

BUILD_ARGS="SOURCE_COMMIT APP_VERSION NODE_BUILDER_TAG RUNTIME_BASE NODEJS_PKG NODEJS_DEVEL_PKG NPM_PKG BUILDER_GCC_VERSION NPM_DIRECT_UPGRADES NPM_OVERRIDES"
