# etcd — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# This image compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=etcd BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves / CVE evidence → README.md
# Decision → docs/decisions/0003-etcd-image-self-build.md

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# The upstream stock image (quay.io/coreos/etcd:v3.7.1) is distinguished by the tag slug
# (TAG_SLUG=security), so the version string itself is left as-is.
APP_VERSION=3.7.1

# The actual commit the v3.7.1 tag points at (the peeled commit, not the tag object). To check:
#   git ls-remote --tags https://github.com/etcd-io/etcd.git v3.7.1 v3.7.1^{}
SOURCE_COMMIT=5e7fd0de9a57db03ecc11794dc40403a734c07bb

# An official golang image tag satisfying go.mod's `go 1.26` / `toolchain go1.26.5`.
# Used only in the builder stage; it does not survive into the final image.
#
# The value is chosen not by go.mod's minimum but by **the point that resolves the blocking
# stdlib CVEs** — it rises when CVE data is updated, even with no source change. Do not pick
# it by hand:
#   python3 scripts/build/suggest-go-upgrades.py --reports <trivy-reports> --image etcd
GO_BUILDER_TAG=1.26.6-trixie

# Final runtime base — the images in this repository use SUSE BCI only
# (docs/image-authoring/README.md rule 2). The binary is statically linked (CGO_ENABLED=0),
# so the lightest variant without a package manager, bci-micro, is sufficient.
RUNTIME_BASE=registry.suse.com/bci/bci-micro:15.7

# Forced upgrade version for the statically linked golang.org/x/text — not tracked
# automatically; a person decides it.
# Rationale: docs/decisions/0003-etcd-image-self-build.md
XTEXT_FIX_VERSION=0.39.0

BUILD_ARGS="SOURCE_COMMIT GO_BUILDER_TAG APP_VERSION RUNTIME_BASE XTEXT_FIX_VERSION"
