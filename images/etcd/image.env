# Default build variant — used when no base_os input is given
# (images/<image>/<DEFAULT_BASE_OS>.build.env)
DEFAULT_BASE_OS=source

# Display group in the root README's published-images table.
# See scripts/build/render-published-images-table.py.
CATEGORY=etcd

# Upstream support line — which release line this image is entitled to sit on.
# Checked by scripts/build/check-support-line.py; see docs/image-authoring/support-policy.md.
SUPPORT_SOURCE=endoflife.date
SUPPORT_PRODUCT=etcd
SUPPORT_LINE=3.7
SUPPORT_NOTE="etcd maintains several release-3.x branches in parallel."
