# Keycloak self-build — SUSE BCI based, including the vulnerable jar overlay
#
# APP_VERSION is the Keycloak release version. The tag becomes
#   <registry>/keycloak:<APP_VERSION>-<TAG_SLUG>-hardened-<YYYYMMDD>
# (build-hardened-image.sh).
DOCKERFILE=suse.Dockerfile
TARGET=final
TAG_SLUG=bci15.7
APP_VERSION=26.7.1
KEYCLOAK_VERSION=26.7.1

# BCI 16.0 exists, but 15.7 is used — its JDK patch level is ahead of 16.0's (the detailed
# comparison is in ADR 0008). Move up when 16.0 catches up with 15.7. To re-measure when a
# new BCI appears, compare java-21-openjdk-headless with:
#   docker run --rm registry.suse.com/bci/bci-base:<tag> \
#     sh -c 'zypper -n refresh >/dev/null 2>&1; zypper -n info java-21-openjdk-headless'
BUILDER_BASE=registry.suse.com/bci/bci-base:15.7
MICRO_BASE=registry.suse.com/bci/bci-micro:15.7

# The SUSE equivalent of the 44-package rpm closure upstream's ubi-null.sh leaves on top of
# ubi9-micro. sed, grep, and findutils are not optional — bin/kc.sh uses them, and
# bci-micro has none of the three (see "Common tools missing from bci-micro" in
# docs/image-authoring/base-os-policy.md).
#
# Package name caveats (SLE_BCI 15.7)
#   tzdata      → does not exist in SLE. The name is `timezone`.
#   tzdata-java → no SLE equivalent. Java uses the JDK's bundled tzdb.
# bash, coreutils, and ca-certificates-mozilla are already in the bci-micro seed (zypper
# skips them as "already installed"). They are kept in the list to make the requirement
# explicit.
RUNTIME_PACKAGES="java-21-openjdk-headless glibc-locale-base ca-certificates-mozilla bash coreutils sed grep findutils timezone"

# Vulnerable jar overlay targets. <OLD> is the version the keycloak $KEYCLOAK_VERSION
# distribution actually ships; <NEW> is the fixed version for the blocking CVE.
# overlay-jars.sh fails immediately if it cannot find a file at OLD — this prevents the
# overlay from silently becoming a no-op when upstream bumps the version.
# The values are forced upgrades in response to CVEs — the CVE list is in README.md.
#
# For netty, the whole family is raised rather than only the artifacts with a CVE —
# mixing versions across its artifacts is unsupported.
NETTY_OLD=4.1.135.Final
NETTY_VERSION=4.1.136.Final
# jackson-annotations is versioned separately at 2.21 and has no CVE, so it is left alone.
JACKSON_OLD=2.21.2
JACKSON_VERSION=2.21.4
PGJDBC_OLD=42.7.11
PGJDBC_VERSION=42.7.12
# micrometer raises its whole family for the same reason as netty (commons, core,
# observation, registry-prometheus-simpleclient).
MICROMETER_OLD=1.16.3
MICROMETER_VERSION=1.16.6

BUILD_ARGS="KEYCLOAK_VERSION BUILDER_BASE MICRO_BASE RUNTIME_PACKAGES NETTY_OLD NETTY_VERSION JACKSON_OLD JACKSON_VERSION PGJDBC_OLD PGJDBC_VERSION MICROMETER_OLD MICROMETER_VERSION"
