# apisix-ingress-controller — source-compiled self-build (the only variant)
#
# Sourced by build-hardened-image.sh. Only names listed in BUILD_ARGS are passed as --build-arg.
# This image compiles from source, so there is no "base OS" choice — call it with BASE_OS=source:
#   IMAGE=apisix-ingress-controller BASE_OS=source bash scripts/build/build-hardened-image.sh <OUT_DIR>
#
# Why we build this ourselves → README.md.

DOCKERFILE=source.Dockerfile
TARGET=final
TAG_SLUG=security

# The generic required value build-hardened-image.sh needs for the tag and for verify.sh.
# The stock 2.1.0 is distinguished by the tag slug (TAG_SLUG=security), so the version
# string itself is left as-is.
APP_VERSION=2.1.0

# The actual commit the v2.1.0 tag points at (the peeled commit). Why the tag is used as-is:
# see README.md.
SOURCE_COMMIT=f4a8dd1223573a5b72e1c7b65b37c13b49d98042

# The default MIN_K8S_VERSION from upstream's Makefile (baked into the binary via ldflags).
MIN_K8S_VERSION=1.26.0

# An official golang image tag satisfying go.mod's `go`/`toolchain` requirements. Used only
# in the builder stage; it does not survive into the final image. Do not pick it by hand —
# derive the value with:
#   python3 scripts/build/suggest-go-upgrades.py --reports <trivy-reports> --image apisix-ingress-controller
GO_BUILDER_TAG=1.26.6-trixie

# Final runtime base — this repository uses SUSE BCI only (docs/image-authoring/README.md rule 2).
# The binary is statically linked (CGO_ENABLED=0), so the lightest variant without a package
# manager, bci-micro, is sufficient.
RUNTIME_BASE=registry.suse.com/bci/bci-micro:15.7

# Minimum versions for force-upgrading vulnerable modules (see README.md). `go get` settles
# on a mutually compatible combination — individual go.sum versions are not listed here.
XNET_FIX_VERSION=0.56.0
XTEXT_FIX_VERSION=0.39.0
GRPC_FIX_VERSION=1.82.1
OTEL_FIX_VERSION=1.43.0

BUILD_ARGS="SOURCE_COMMIT APP_VERSION MIN_K8S_VERSION GO_BUILDER_TAG RUNTIME_BASE XNET_FIX_VERSION XTEXT_FIX_VERSION GRPC_FIX_VERSION OTEL_FIX_VERSION"
